{
  "name": "dsmod",
  "version": "0.1.0",
  "description": "Client-level Discord API for a Discord mod: login (password/MFA/QR), chats, messages, gateway events, and a local HTTP bridge for the UI.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/server/main.ts",
    "dev": "bun run --watch src/server/main.ts",
    "example": "bun run examples/cli.ts",
    "build:exe": "bun build --compile src/server/main.ts --asset examples/ui --outfile dist/dsmod-bridge.exe",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.0"
  }
}
