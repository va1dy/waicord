# Токен user-аккаунта (появляется после входа). Никогда не коммитить реальный токен.
# DSMOD_TOKEN=

# Локальный bridge-сервер (UI ходит на него по HTTP/WS)
DSMOD_HOST=127.0.0.1
DSMOD_PORT=8787

# Если задан — UI обязан присылать заголовок `x-dsmod-key` с этим значением
# DSMOD_KEY=

# Путь к файлу сессии (по умолчанию ~/.dsmod/session.json)
# DSMOD_SESSION_PATH=
