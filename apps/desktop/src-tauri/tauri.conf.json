{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "waicord",
  "version": "0.1.0",
  "identifier": "dev.waicord.client",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "waicord",
        "width": 1120,
        "height": 720,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
